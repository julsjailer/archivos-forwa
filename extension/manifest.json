{
  "manifest_version": 3,
  "name": "Stickers con sonido",
  "version": "0.7.4",
  "description": "Crea stickers con sonido a partir de un video, una imagen o un GIF y envíalos desde WhatsApp Web. Extensión no oficial.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Crear sticker con sonido"
  },
  "options_page": "registro.html",
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "src/bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "src/logger.js",
        "src/convert.js",
        "src/wa.js",
        "src/ui.js",
        "src/main.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
